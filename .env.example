# Catedra · Plantilla de variables de entorno
# ---------------------------------------------------------------------------
# NO pongas claves reales en este archivo ni en el repositorio.
# Este archivo es solo la LISTA de nombres. Los valores van en Vercel:
#   Vercel -> proyecto catedra -> Settings -> Environment Variables.
# Guía paso a paso: docs/product/guia-encender-ia.md
# ---------------------------------------------------------------------------

# --- IA (al menos UNA clave para que la app genere preguntas) ---
# Groq: gratis, rápido, para texto. console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: gratis, respaldo si Groq se queda sin cupo. openrouter.ai/keys
OPENROUTER_API_KEY=
# Gemini: gratis, único que lee FOTOS de apuntes. aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Acceso al piloto (OBLIGATORIO para que la IA se encienda) ---
# Códigos separados por coma, uno por persona o grupo. Invéntalos tú.
# La IA NO funciona para nadie sin al menos un código aquí (o AI_OPEN=1).
PILOT_CODES=piloto-uno,piloto-dos,piloto-tres

# --- Opcionales ---
# Límite diario de llamadas de IA por estudiante (protege tu cupo gratis).
AI_DAILY_LIMIT_PER_USER=25
# Interruptor de emergencia: pon "false" y redespliega para apagar la IA al instante.
# AI_ENABLED=true
# Abrir la IA a cualquiera sin código (NO recomendado en el piloto).
# AI_OPEN=1
# Privacidad: si no quieres que NINGÚN texto de estudiantes llegue a Google,
# descomenta. (La transcripción de fotos seguirá usando Gemini si hay clave.)
# AI_NO_GEMINI_TEXT=1

# --- Medición anónima de uso (opcional pero recomendado) ---
# PostHog, plan gratis sin tarjeta. posthog.com
POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# --- Formulario de opiniones (opcional) ---
# Enlace de un Google Form o Tally; aparece como botón de feedback en la app.
FEEDBACK_URL=

# --- Modelos (opcional: cámbialos sin tocar código) ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_VISION_MODEL=gemini-2.5-flash
